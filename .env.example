DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mcp_demo
DB_USER=mcp_reader
DB_PASSWORD=change-me
DB_POOL_SIZE=5
DB_MAX_ROWS=100
DB_STATEMENT_TIMEOUT_MS=10000
# Optional comma-separated filter for MCP table metadata.
DB_ALLOWED_TABLES=customers,orders

# Optional MySQL store for connection lists and MCP tokens.
# CONFIG_DB_HOST=127.0.0.1
# CONFIG_DB_PORT=3306
# CONFIG_DB_NAME=libra_mcp
# CONFIG_DB_USER=libra_mcp_admin
# CONFIG_DB_PASSWORD=change-me
# DB_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Web management binds to 127.0.0.1.
WEB_PORT=3000
# WEB_ADMIN_PASSWORD=   # Optional. If unset, a random password is saved locally.
# DB_CONFIG_DIR=/absolute/path/to/config
